# Template installed by alerts/deploy/install-on-host.sh.
# Placeholders are replaced on the droplet. This file is not copied into
# /etc/systemd/system until those placeholders are gone.

[Unit]
Description=Phaneroo SACCO transactional alerts
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__DEST__
Environment=PORT=8095
Environment=NODE_ENV=production
Environment=ALERTS_DATA_FILE=__DEST__/data/store.json
EnvironmentFile=-__ENV_FILE__
ExecStart=__NODE_BIN__ server.js
Restart=on-failure
RestartSec=3
StartLimitIntervalSec=60
StartLimitBurst=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=__DEST__/data

[Install]
WantedBy=multi-user.target
