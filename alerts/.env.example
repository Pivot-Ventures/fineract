# Local: export these in the shell before `npm start`.
# Production: copy to /etc/pivot-sacco/alerts.env (mode 600, owner root).
# systemd EnvironmentFile loads that path. Deploy SACCO Alerts never
# writes it. Never commit real values. Never put AT_* or LIPECHAT_*
# in GitHub Actions secrets; the workflow does not read them.
# This process does not load a .env file by itself.

PORT=8095

# Set to true to log intended provider payloads and skip HTTP,
# even when keys are present. When unset or false, a provider
# with missing credentials still dry-runs on its own.
ALERTS_DRY_RUN=

# Optional. When set, every route except GET /health requires
# X-Alerts-Key or Authorization: Bearer. Leave unset only when
# the process is bound to localhost behind nginx.
ALERTS_API_KEY=

# JSON file for templates and the delivery log. Swap for Postgres later.
ALERTS_DATA_FILE=

# Africa's Talking SMS
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Live default. Sandbox: https://api.sandbox.africastalking.com
AT_BASE_URL=https://api.africastalking.com

# LipeChat WhatsApp templates
LIPECHAT_API_KEY=
LIPECHAT_FROM=
LIPECHAT_BASE_URL=https://gateway.lipachat.com

# Email is a config slot only. No provider is called in v1.
ALERTS_EMAIL_FROM=
