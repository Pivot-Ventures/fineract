# Transactional alerts. This process does not load a .env file by itself.
# Production (docker compose, deploy/production): compose already sets HOST, PORT,
# FINERACT_URL, FINERACT_TENANT, ALERTS_SERVICE_KEY and ALERTS_DATA_DIR. Put the
# provider credentials, ALERTS_LIVE and any limits in deploy/production/alerts.env
# (mode 600, never committed).
# Local: export these in the shell before `npm start`.

# Bind address. Loopback by default; the Dockerfile sets 0.0.0.0 inside the container.
HOST=127.0.0.1
PORT=8095

# --- Authentication -------------------------------------------------------
# Staff (Desk) sign-in is checked against Fineract POST /authentication, and
# staff events read their facts from Fineract with the staff credentials.
FINERACT_URL=
FINERACT_TENANT=default
# Shared key for the member gateway (header X-Alerts-Service-Key). Empty = refused.
# With neither FINERACT_URL nor ALERTS_SERVICE_KEY set, every route but /v1/health is 503.
ALERTS_SERVICE_KEY=
# Fineract permission (besides ALL_FUNCTIONS) that may manage templates, test-send,
# read deliveries and settings.
ALERTS_ADMIN_PERMISSION=ALL_FUNCTIONS

# --- Go live ---------------------------------------------------------------
# Dry-run unless this is exactly "true" AND the provider credentials below are set.
ALERTS_LIVE=

# sms | whatsapp | whatsapp,sms  (WhatsApp first, SMS only if WhatsApp fails; never both)
ALERTS_CHANNEL_ORDER=sms

# --- Limits ----------------------------------------------------------------
ALERTS_PER_PHONE_HOURLY=10
ALERTS_DAILY_CAP=2000
ALERTS_RATE_PER_MINUTE=120
# true behind Caddy/nginx: rate-limit by the last X-Forwarded-For entry.
ALERTS_TRUST_PROXY=
# Extra E.164 prefixes accepted besides Ugandan mobiles, e.g. +2547 (full + form only).
ALERTS_EXTRA_PREFIXES=

# Shown as {{branch}}: "If this wasn't you, call <this> now."
ALERTS_BRANCH_CONTACT=your SACCO branch

# --- Storage ---------------------------------------------------------------
# Directory for store.json (templates, delivery log, idempotency, caps).
ALERTS_DATA_DIR=
# Full path override.
ALERTS_DATA_FILE=

# --- Africa's Talking SMS --------------------------------------------------
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Live default. Sandbox: https://api.sandbox.africastalking.com
AT_BASE_URL=https://api.africastalking.com

# --- LipeChat WhatsApp templates -------------------------------------------
LIPECHAT_API_KEY=
LIPECHAT_FROM=
LIPECHAT_BASE_URL=https://gateway.lipachat.com
