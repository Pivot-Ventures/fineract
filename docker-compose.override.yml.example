# macOS AirPlay Receiver binds host port 5000. docker-compose.yml also
# publishes Fineract's container port 5000, so `docker compose up` fails
# while AirPlay is on. Copy this file to docker-compose.override.yml
# (gitignored) to publish only the API port:
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#   docker compose up -d
#
# Fineract is then at https://localhost:8443/fineract-provider/
# Pivot SACCO Desk (cd desk && ./start-desk.sh) proxies that URL.
#
# Requires Docker Compose v2, which honors the !override tag and replaces
# the ports list instead of appending 5000 back.

services:
  fineract:
    ports: !override
      - "8443:8443"
