<?xml version="1.0" encoding="utf-8"?>
<!-- Allow cleartext HTTP to the LAN mobile web UI (dev). Tighten for production. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
