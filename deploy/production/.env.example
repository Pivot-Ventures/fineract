# Pivot SACCO production settings.
# Do not edit this file with real secrets. Run scripts/gen-secrets.sh, which copies it to .env
# (git-ignored, mode 600) and fills every CHANGE_ME with a random value.

# Hostname staff use to open Desk, e.g. desk.pivotsacco.co.ug (public DNS) or desk.pivot.lan (LAN).
DESK_DOMAIN=desk.pivot.lan
# "internal" = Caddy's own CA (LAN only). An e-mail address = public Let's Encrypt certificate.
CADDY_TLS=internal
HTTP_PORT=80
HTTPS_PORT=443

# Pin the exact image you tested, by digest, e.g. apache/fineract@sha256:...
FINERACT_IMAGE=fineract:latest
FINERACT_HEAP=2g
FINERACT_MEM_LIMIT=3g

# Tenant created on first boot. Desk sends this as Fineract-Platform-TenantId.
FINERACT_TENANT_ID=default
FINERACT_TENANT_DB_NAME=fineract_default
FINERACT_TENANT_NAME="Pivot SACCO"

# Secrets — generated.
POSTGRES_SUPERUSER=pgadmin
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
FINERACT_DB_USER=fineract_app
FINERACT_DB_PASSWORD=CHANGE_ME
FINERACT_MASTER_PASSWORD=CHANGE_ME

# Member gateway (Pivosacc app). Leave the password empty: scripts/create-gateway-user.sh creates
# this Fineract user (read + account-transfer permissions only) and writes its password here.
GATEWAY_FINERACT_USER=mobile-gateway
GATEWAY_FINERACT_PASSWORD=
# Mobile limits in UGX — pending Board sign-off.
MOBILE_LIMIT_PER_TXN=2000000
MOBILE_LIMIT_PER_DAY=5000000

# Backups (scripts/backup.sh)
BACKUP_DIR=/var/backups/pivot-sacco
BACKUP_RETENTION_DAYS=30
# Optional command run after each backup to copy it off this machine; receives the backup folder
# as $1. Example: rclone copy "$1" offsite:pivot-sacco-backups/$(basename "$1")
BACKUP_OFFSITE_CMD=
