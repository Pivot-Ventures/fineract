# Gateway route body for the SACCO droplet (sacco.pivotventures.tech).
#
# The production compose file mounts this directory at /etc/caddy (read-only).
# Caddyfile and Caddyfile.behind-proxy both import this file, so a gateway
# recreate keeps one allowlist. Do not duplicate these matchers elsewhere.
#
#   /                             → Desk static UI (allowlisted paths only)
#   /payments-portal/*            → payments portal (desk/payments-portal)
#   /transactional-alerts/*       → alerts ops UI (desk/transactional-alerts)
#   /fineract-provider/api/*      → Fineract (private network, plain HTTP)
#   /mobile/api/*                 → member gateway
# Everything else (actuator, Swagger, API docs, stray files) → 404.
#
# /alerts/* is not routed here. The alerts process listens on the host at
# 127.0.0.1:8095, and this file is loaded inside the gateway container, where
# 127.0.0.1 is the container itself. Host Caddy owns that proxy. The source
# of truth is alerts/deploy/caddy-alerts.caddy. Do not reload the incomplete
# host file /etc/caddy/Caddyfile.

encode zstd gzip

request_body {
	max_size 20MB
}

header {
	Strict-Transport-Security "max-age=31536000"
	X-Content-Type-Options "nosniff"
	X-Frame-Options "DENY"
	Referrer-Policy "no-referrer"
	Permissions-Policy "camera=(self), microphone=(), geolocation=()"
	Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	-Server
}

# Members never reach Fineract directly: the app talks only to the gateway, which checks
# ownership of every account it touches.
handle_path /mobile/api/* {
	reverse_proxy gateway:8000 {
		header_down -Server
	}
}

handle /fineract-provider/api/* {
	reverse_proxy fineract:8080 {
		header_down -Server
	}
}

# Desk: HTML pages, assets, and the two staff folders below.
# Never server.py, scripts/, READMEs, or dotfiles.
# A new Desk directory 404s until it is added to this path list.
@desk {
	path / /*.html /assets/* /payments-portal /payments-portal/* /transactional-alerts /transactional-alerts/*
	not path /.* /assets/.* /payments-portal/.* /transactional-alerts/.*
}
handle @desk {
	root * /srv/desk
	file_server
}

handle {
	respond 404
}

log {
	output stdout
	format json
}
