# Pivot SACCO — edge proxy (standalone server: this Caddy owns ports 80/443).
# CADDY_TLS: "internal" for a LAN-only install (Caddy's own CA; install its root on staff PCs),
#            or an e-mail address to obtain a public Let's Encrypt certificate for DESK_DOMAIN.
# On a server where another proxy already owns 80/443, use Caddyfile.behind-proxy instead
# (see docker-compose.behind-proxy.yml).

{$DESK_DOMAIN} {
	tls {$CADDY_TLS}
	import routes.caddy
}
